{
  "name": "@signal-kernel/settle",
  "version": "0.1.0",
  "description": "Execution validity for changing reactive systems.",
  "type": "module",
  "author": "Luciano Lee",
  "license": "Apache-2.0",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Luciano0322/settle.git"
  },
  "homepage": "https://github.com/Luciano0322/settle#readme",
  "bugs": {
    "url": "https://github.com/Luciano0322/settle/issues"
  },
  "keywords": [
    "signal-kernel",
    "reactivity",
    "reactive-system",
    "async",
    "causal-consistency",
    "invalidation",
    "settlement",
    "typescript"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@signal-kernel/async-runtime": "^0.4.1",
    "@signal-kernel/core": "^0.1.5",
    "@signal-kernel/snapshot": "^0.1.0"
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --sourcemap --clean",
    "lint": "eslint src tests examples --max-warnings 0",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:browser": "pnpm build && playwright test",
    "dependency:check": "node scripts/check-dependencies.mjs",
    "package:check": "publint",
    "package:smoke": "node scripts/smoke-node.mjs && node --eval \"require('@signal-kernel/settle')\"",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm dependency:check && pnpm build && pnpm package:check && pnpm package:smoke",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && pnpm package:check && changeset publish"
  },
  "packageManager": "pnpm@10.34.5",
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@inngest/test": "1.0.0",
    "@langchain/core": "1.2.1",
    "@langchain/langgraph": "1.5.1",
    "@playwright/test": "1.64.1",
    "@signal-kernel/async-runtime": "0.4.1",
    "@signal-kernel/core": "0.1.5",
    "@signal-kernel/snapshot": "0.1.0",
    "@temporalio/activity": "1.24.0",
    "@temporalio/testing": "1.24.0",
    "@temporalio/workflow": "1.24.0",
    "@types/node": "^22.12.0",
    "esbuild": "0.28.2",
    "eslint": "^10.11.0",
    "inngest": "4.24.0",
    "publint": "^0.3.24",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1"
  }
}
